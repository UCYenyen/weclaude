{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "M=\"$HOME/.local/bin/weclaude\"; [ -x \"$M\" ] || M=\"${CLAUDE_PLUGIN_ROOT}/bin/weclaude\"; \"$M\" session-start \"${CLAUDE_PLUGIN_ROOT}\""
          },
          {
            "type": "command",
            "command": "M=\"$HOME/.local/bin/weclaude\"; [ -x \"$M\" ] || M=\"${CLAUDE_PLUGIN_ROOT}/bin/weclaude\"; \"$M\" listen",
            "async": true,
            "asyncRewake": true,
            "timeout": 31536000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "M=\"$HOME/.local/bin/weclaude\"; [ -x \"$M\" ] || M=\"${CLAUDE_PLUGIN_ROOT}/bin/weclaude\"; \"$M\" state thinking"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "M=\"$HOME/.local/bin/weclaude\"; [ -x \"$M\" ] || M=\"${CLAUDE_PLUGIN_ROOT}/bin/weclaude\"; \"$M\" hook PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "M=\"$HOME/.local/bin/weclaude\"; [ -x \"$M\" ] || M=\"${CLAUDE_PLUGIN_ROOT}/bin/weclaude\"; \"$M\" state thinking"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "M=\"$HOME/.local/bin/weclaude\"; [ -x \"$M\" ] || M=\"${CLAUDE_PLUGIN_ROOT}/bin/weclaude\"; \"$M\" state idle"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "M=\"$HOME/.local/bin/weclaude\"; [ -x \"$M\" ] || M=\"${CLAUDE_PLUGIN_ROOT}/bin/weclaude\"; \"$M\" hook PreCompact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "M=\"$HOME/.local/bin/weclaude\"; [ -x \"$M\" ] || M=\"${CLAUDE_PLUGIN_ROOT}/bin/weclaude\"; \"$M\" state idle"
          },
          {
            "type": "command",
            "command": "M=\"$HOME/.local/bin/weclaude\"; [ -x \"$M\" ] || M=\"${CLAUDE_PLUGIN_ROOT}/bin/weclaude\"; \"$M\" listen",
            "async": true,
            "asyncRewake": true,
            "timeout": 31536000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "M=\"$HOME/.local/bin/weclaude\"; [ -x \"$M\" ] || M=\"${CLAUDE_PLUGIN_ROOT}/bin/weclaude\"; \"$M\" state idle"
          }
        ]
      }
    ]
  }
}
