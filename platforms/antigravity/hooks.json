{
  "weclaude": {
    "SessionStart": [
      { "type": "command", "command": "WECLAUDE_PLATFORM=ANTIGRAVITY ./bin/weclaude session-start \"$(pwd)\"" }
    ],
    "PreInvocation": [
      { "type": "command", "command": "WECLAUDE_PLATFORM=ANTIGRAVITY ./bin/weclaude state thinking" }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "WECLAUDE_PLATFORM=ANTIGRAVITY ./bin/weclaude state thinking" }
        ]
      }
    ],
    "Stop": [
      { "type": "command", "command": "WECLAUDE_PLATFORM=ANTIGRAVITY ./bin/weclaude state idle" }
    ]
  }
}
